@@ -0,0 +1,69 @@
+import { createFileRoute } from "@tanstack/react-router";
+import { cotlHead } from "@/children-of-the-lance/lib/head";
+import { COTL_BASE } from "@/children-of-the-lance/data/site";
+
+// Key locations named in the conflict. Edit freely.
+const LOCATIONS = ["Solace", "Qualinesti", "Palanthas", "Neraka"];
+
+export const Route = createFileRoute("/projetos/children-of-the-lance/conflito")({
+  head: () =>
+    cotlHead(
+      "O Conflito · Children of the Lance",
+      "The search for the Silver Child, the Eight Knights of Takhisis, and the places where the hunt plays out: Solace, Qualinesti, Palanthas and Neraka.",
+      "/conflito",
+    ),
+  component: ConflitoPage,
+});
+
+function ConflitoPage() {
+  return (
+    <div className="cotl-container cotl-section">
+      <p className="cotl-eyebrow">O Conflito</p>
+      <h1>The Conflict</h1>
+
+      <div className="cotl-prose">
+        <p className="cotl-lead">
+          Everything turns on the <strong>Silver Child</strong>, born of a dragon and a mortal. Both
+          sides are hunting the child, and only one can be allowed to reach it first.
+        </p>
+
+        <h2>The Silver Child</h2>
+        <p>
+          The Eight Knights of Takhisis want the Silver Child for their dark plans. The Children of
+          the Lance have to find the child first and keep it out of the Empire's hands before it is
+          too late. Placeholder text — add the details you want to reveal, and the ones you want to
+          hold back.
+        </p>
+
+        <h2>The Eight Knights of Takhisis</h2>
+        <p>
+          Eight Dragon Knights lead the Dragon Empire, each bonded to a powerful dragon. They are
+          commanded by <strong>Ariakan Ariakas</strong>, the Red Dragon Knight and son of the former
+          Dragon Emperor Duulket Ariakas. Among them moves the mysterious <strong>Zorath</strong>,
+          the Purple Dragon Knight, whose orders are never written down.
+        </p>
+        <p>
+          Older and colder still, <strong>Lord Soth</strong>, the Knight of the Black Rose, rides
+          with the Eight as a returning legend, allied with their cause or quietly bending it toward
+          his own ends.
+        </p>
+
+        <h2>Where it plays out</h2>
+        <p>The hunt crosses Ansalon, through places the old stories made famous:</p>
+      </div>
+
+      <div className="cotl-chips" style={{ marginTop: "1rem" }}>
+        {LOCATIONS.map((place) => (
+          <span key={place} className="cotl-chip">
+            {place}
+          </span>
+        ))}
+      </div>
+
+      <hr className="cotl-divider" />
+      <a className="cotl-btn cotl-btn--primary" href={`${COTL_BASE}/ler`}>
+        Read the Story
+      </a>
+    </div>
+  );
+}
