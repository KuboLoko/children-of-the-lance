@@ -0,0 +1,72 @@
+import { createFileRoute } from "@tanstack/react-router";
+import { cotlHead } from "@/children-of-the-lance/lib/head";
+import { COTL_DISCLAIMER } from "@/children-of-the-lance/data/site";
+import { ALL_CHARACTERS } from "@/children-of-the-lance/data/characters";
+
+export const Route = createFileRoute("/projetos/children-of-the-lance/creditos")({
+  head: () =>
+    cotlHead(
+      "Créditos e Aviso Legal · Children of the Lance",
+      "Full disclaimer for Children of the Lance, an unofficial fan work, plus artwork credits.",
+      "/creditos",
+    ),
+  component: CreditosPage,
+});
+
+function CreditosPage() {
+  // Only characters whose art is borrowed need a credit line here.
+  const credited = ALL_CHARACTERS.filter((c) => c.image && c.artist);
+
+  return (
+    <div className="cotl-container cotl-section">
+      <p className="cotl-eyebrow">Créditos e Aviso Legal</p>
+      <h1>Credits &amp; Disclaimer</h1>
+
+      <div className="cotl-prose">
+        <h2>Unofficial fan work</h2>
+        <p>
+          Children of the Lance is a non-commercial, fan-made continuation of the Dragonlance
+          Chronicles. It is made by fans, for fans, and earns no money. It is not an official
+          Dragonlance product.
+        </p>
+
+        <h2>Legal disclaimer</h2>
+        <p>{COTL_DISCLAIMER}</p>
+
+        <h2>Artwork credits</h2>
+        {credited.length > 0 ? (
+          <ul className="cotl-list">
+            {credited.map((c) => (
+              <li key={c.id}>
+                <strong>{c.name}</strong> — artwork: {c.artist}
+              </li>
+            ))}
+          </ul>
+        ) : (
+          <p>
+            <em>
+              No borrowed artwork credited yet. Add the artist's name to each entry in{" "}
+              <code>data/characters.ts</code> and it appears here and beneath the image on the
+              Characters page.
+            </em>
