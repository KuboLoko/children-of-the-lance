+import { createFileRoute, Outlet } from "@tanstack/react-router";
+import { CotLLayout } from "@/children-of-the-lance/components/CotLLayout";
+
+/**
+ * Layout route for the "Children of the Lance" fan subsection.
+ *
+ * TanStack Start file-based routing: this `route.tsx` wraps every page in
+ * `src/routes/projetos/children-of-the-lance/` (index.tsx, historia.tsx, ...).
+ * It loads the two display fonts used only here and renders the shared
+ * navbar + footer via <CotLLayout>. Individual pages set their own title,
+ * description and `robots: noindex` in their own `head`.
+ */
+export const Route = createFileRoute("/projetos/children-of-the-lance")({
+  head: () => ({
+    meta: [{ name: "robots", content: "noindex, follow" }],
+    links: [
+      {
+        rel: "stylesheet",
+        href: "https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap",
+      },
+    ],
+  }),
+  component: RouteComponent,
+});
+
+function RouteComponent() {
+  return (
+    <CotLLayout>
+      <Outlet />
+    </CotLLayout>
+  );
+}
