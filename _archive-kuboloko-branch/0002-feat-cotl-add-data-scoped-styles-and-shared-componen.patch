@@ -0,0 +1,47 @@
+import { useEffect, useRef, useState } from "react";
+import { COTL_LOGO } from "../data/site";
+
+/**
+ * Shows the official Dragonlance logo image. Until that file exists at
+ * /public/projetos/children-of-the-lance/dragonlance-logo.png, it falls back
+ * to a plain text wordmark so nothing looks broken.
+ *
+ * The `onError` handler covers the normal case; the `useEffect` check covers
+ * the server-rendered case where the 404 can happen before React attaches its
+ * listener (so `onError` never fires on the client).
+ *
+ * @param className         Applied to the <img>.
+ * @param fallbackClassName Applied to the <span> wordmark when the image is missing.
+ */
+export function CotLLogo({
+  className,
+  fallbackClassName,
+}: {
+  className?: string;
+  fallbackClassName?: string;
+}) {
+  const [failed, setFailed] = useState(false);
+  const imgRef = useRef<HTMLImageElement>(null);
+
+  useEffect(() => {
+    const img = imgRef.current;
+    // If the image finished loading but has no size, it 404'd before hydration.
+    if (img && img.complete && img.naturalWidth === 0) {
+      setFailed(true);
+    }
+  }, []);
+
+  if (failed) {
+    return <span className={fallbackClassName ?? className}>Dragonlance</span>;
+  }
+
+  return (
+    <img
+      ref={imgRef}
+      className={className}
+      src={COTL_LOGO}
+      alt="Dragonlance"
+      onError={() => setFailed(true)}
+    />
+  );
+}
diff --git a/src/children-of-the-lance/components/CotLNav.tsx b/src/children-of-the-lance/components/CotLNav.tsx
new file mode 100644
index 0000000..f229e70
--- /dev/null
+++ b/src/children-of-the-lance/components/CotLNav.tsx
@@ -0,0 +1,59 @@
+import { useState } from "react";
+import { useRouterState } from "@tanstack/react-router";
+import { COTL_BASE, COTL_NAV, COTL_TITLE } from "../data/site";
+import { CotLLogo } from "./CotLLogo";
+
+/**
+ * Sticky navbar for the subsection. Uses plain <a> links (full navigation),
+ * matching how the main kuboloko.pt chrome links between pages.
+ *
+ * The logo <img> hides itself if the file is missing, and a text wordmark
+ * shows instead — so the nav never looks broken before the asset is added.
+ */
+export function CotLNav() {
+  const [open, setOpen] = useState(false);
+  const pathname = useRouterState({ select: (s) => s.location.pathname });
+
+  return (
+    <nav className="cotl-nav">
+      <div className="cotl-container cotl-nav__inner">
+        <a href={COTL_BASE} className="cotl-nav__brand">
+          {/* Logo image, or nothing until the file is added. */}
+          <CotLLogo className="cotl-nav__logo" fallbackClassName="cotl-nav__logo-text" />
+          <span>{COTL_TITLE}</span>
+        </a>
+
+        <button
+          type="button"
+          className="cotl-nav__toggle"
+          aria-expanded={open}
+          onClick={() => setOpen((v) => !v)}
+        >
+          {open ? "Fechar" : "Menu"}
+        </button>
+
+        <ul className={`cotl-nav__links${open ? " is-open" : ""}`}>
+          {COTL_NAV.map((item) => {
+            // Exact match for the home link, prefix match for the sub-pages.
+            const active =
+              item.to === COTL_BASE
+                ? pathname === COTL_BASE || pathname === `${COTL_BASE}/`
+                : pathname.startsWith(item.to);
+            return (
+              <li key={item.to}>
+                <a
+                  href={item.to}
+                  className={active ? "is-active" : undefined}
+                  aria-current={active ? "page" : undefined}
+                  onClick={() => setOpen(false)}
+                >
+                  {item.label}
+                </a>
+              </li>
+            );
+          })}
+        </ul>
+      </div>
+    </nav>
+  );
+}
