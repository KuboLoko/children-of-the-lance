+import { COTL_BASE } from "../data/site";
+
+/** Canonical origin for kuboloko.pt (see src/routes/__root.tsx SITE_URL). */
+const SITE_URL = "https://kuboloko.pt";
+
+/**
+ * Builds the `head` object for a page in this subsection.
+ *
+ * Every page in "Children of the Lance" is deliberately `noindex` (it is a
+ * non-commercial fan project), but each still gets a real title and
+ * description for clarity in tabs, history and internal links.
+ *
+ * @param title       Full <title> for the page.
+ * @param description Meta description.
+ * @param path        Path after the subsection base, e.g. "/historia". Use ""
+ *                    for the home page.
+ */
+export function cotlHead(title: string, description: string, path = "") {
+  const url = `${SITE_URL}${COTL_BASE}${path}`;
+  return {
+    meta: [
+      { title },
+      { name: "description", content: description },
+      { name: "robots", content: "noindex, follow" },
+      { property: "og:type", content: "website" },
+      { property: "og:site_name", content: "Kubo Loko" },
+      { property: "og:title", content: title },
+      { property: "og:description", content: description },
+      { property: "og:url", content: url },
+    ],
+    links: [{ rel: "canonical", href: url }],
+  };
+}
