+/**
+ * Shared text and configuration for the "Children of the Lance" fan subsection.
+ *
+ * Everything here is safe to edit without touching component code.
+ * Keep this file in sync with src/children-of-the-lance/data/characters.ts.
+ */
+
+/** Base URL path for every page in this subsection. */
+export const COTL_BASE = "/projetos/children-of-the-lance";
+
+/** Folder (inside /public) where all images for this subsection live. */
+export const COTL_ASSETS = "/projetos/children-of-the-lance";
+
+/** Official Dragonlance logo. Drop the file here with this exact name. */
+export const COTL_LOGO = `${COTL_ASSETS}/dragonlance-logo.png`;
+
+export const COTL_TITLE = "Children of the Lance";
+export const COTL_TAGLINE = "Children versus Legacy";
+
+/**
+ * Mandatory legal disclaimer. Rendered in the footer on every page and again,
+ * in full, on the Credits page. Do not shorten it.
+ */
+export const COTL_DISCLAIMER =
+  "Children of the Lance is an unofficial fan-made work. It is not affiliated " +
+  "with, endorsed by, or connected to Wizards of the Coast. Dragonlance and all " +
+  "related properties are trademarks of Wizards of the Coast.";
+
+/** Short premise used on the Home hero. Edit freely. */
+export const COTL_PREMISE =
+  "Thirty years after the Heroes of the Lance turned back Takhisis, the Queen " +
+  "of Darkness, a new shadow falls over Ansalon. The Dragon Empire and its " +
+  "eight Dragon Knights ride to drag the Queen back into the world. The " +
+  "children and descendants of the old heroes must find one another and stand " +
+  "together, walking the road their parents walked.";
+
+/**
+ * Navigation links for the subsection navbar. Order matters.
+ * `to` values are absolute paths so they work from any page.
+ */
+export const COTL_NAV: { label: string; to: string }[] = [
+  { label: "Início", to: `${COTL_BASE}` },
+  { label: "A História", to: `${COTL_BASE}/historia` },
+  { label: "Personagens", to: `${COTL_BASE}/personagens` },
+  { label: "O Conflito", to: `${COTL_BASE}/conflito` },
+  { label: "Ler a História", to: `${COTL_BASE}/ler` },
+  { label: "Créditos", to: `${COTL_BASE}/creditos` },
